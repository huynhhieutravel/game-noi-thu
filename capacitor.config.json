{
  "appId": "com.yokai.onet",
  "appName": "Foxy Pair",
  "webDir": "dist",
  "backgroundColor": "#0d0f17",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0d0f17",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "ScreenOrientation": {
      "orientation": "landscape"
    }
  }
}
